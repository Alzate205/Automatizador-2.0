# Notificación por email del resumen de cada corrida (opcional).
# Copia este archivo como ".env" y rellena tus datos. Si no lo configuras,
# el bot simplemente omite el email (no falla).
#
# Para Gmail: SMTP_PASS debe ser una "App Password" (no tu clave normal),
# generada en https://myaccount.google.com/apppasswords con la verificación
# en dos pasos activada.

EMAIL_FROM=tuemail@gmail.com
EMAIL_TO=tuemail@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tuemail@gmail.com
SMTP_PASS=tu_app_password
